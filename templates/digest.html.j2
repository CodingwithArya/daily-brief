<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Daily Brief · {{ date_long }}</title>
<style>
:root{--bg:#f7f5f0;--card:#fffdf8;--ink:#1d1b18;--muted:#6b665d;--rule:#e4dfd3;--accent:#b4441e;--accent2:#245a8d;--chip:#efe9dc}
@media (prefers-color-scheme:dark){:root{--bg:#141311;--card:#1c1a17;--ink:#ece7dc;--muted:#a39d90;--rule:#2f2c27;--accent:#ef7d52;--accent2:#7fb2e5;--chip:#28251f}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 "Iowan Old Style","Charter","Georgia",serif}
.wrap{max-width:760px;margin:0 auto;padding:28px 16px 64px}
header{border-bottom:2px solid var(--ink);padding-bottom:14px;margin-bottom:20px}
.kicker{font:600 12px/1 ui-sans-serif,system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
h1{font-size:34px;line-height:1.1;margin:8px 0 6px}
.meta{font:13px/1.4 ui-sans-serif,system-ui,sans-serif;color:var(--muted)}
h2{font:700 13px/1.2 ui-sans-serif,system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;margin:34px 0 10px;padding-bottom:6px;border-bottom:1px solid var(--rule)}
.tldr{background:var(--card);border:1px solid var(--rule);border-left:4px solid var(--accent);padding:12px 16px;border-radius:6px}
.tldr li{margin:4px 0}
.queue{display:grid;gap:10px;grid-template-columns:1fr}
@media(min-width:620px){.queue{grid-template-columns:1fr 1fr}}
.q{background:var(--card);border:1px solid var(--rule);border-radius:8px;padding:12px 14px}
.q .lbl{font:600 11px/1 ui-sans-serif,system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--accent2)}
.q > a{display:block;margin-top:6px;font-weight:600}
.srcs{margin:8px 0 6px;padding-left:20px;font-size:14.5px}.srcs li{margin:3px 0}
a{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--rule)}
a:hover{border-bottom-color:var(--accent)}
.item{padding:10px 0;border-bottom:1px dashed var(--rule)}
.item:last-child{border-bottom:0}
.item .t{font-size:17.5px;font-weight:600;line-height:1.3}
.item .src{font:12px/1.4 ui-sans-serif,system-ui,sans-serif;color:var(--muted);margin-top:3px}
.chip{display:inline-block;background:var(--chip);border-radius:99px;padding:1px 8px;margin-right:6px;font-size:11.5px}
.item .why{margin-top:4px;color:var(--accent2);font-style:italic}
.item .sum{margin-top:4px;color:var(--muted);font-size:14.5px}
.op{background:var(--card);border:1px solid var(--rule);border-radius:8px;padding:12px 16px;margin:10px 0}
.op .qq{font-weight:700}
.op .side{font-size:14.5px;margin-top:4px}
.op .side b{font:600 11px ui-sans-serif,system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase}
footer{margin-top:40px;font:13px/1.5 ui-sans-serif,system-ui,sans-serif;color:var(--muted)}
</style>
</head>
<body><div class="wrap">
<header>
  <div class="kicker">Daily Brief · {{ weekday }}</div>
  <h1>{{ date_long }}</h1>
  <div class="meta">{{ n_items }} picks · ~{{ read_min }} min reading · {{ listen_min }} min of audio/video on deck</div>
</header>

{% if tldr %}
<div class="tldr"><b>The day in 30 seconds</b><ul>{% for b in tldr %}<li>{{ b }}</li>{% endfor %}</ul></div>
{% endif %}

{% if episodes %}
<h2>🎧 Today's podcast episodes</h2>
{% for ep in episodes %}
<div class="q" style="margin-bottom:10px"><div class="lbl">{{ ep.label }}</div>
  {% if ep.url %}<a href="{{ ep.url }}">{{ ep.title }}</a>{% else %}<div style="margin-top:6px;font-weight:600">{{ ep.title }}</div>{% endif %}
  <ol class="srcs">{% for s in ep.sources %}<li><a href="{{ s.url }}">{{ s.title }}</a>{% if s.kind != 'paper' %} <span class="chip">{{ s.kind }}</span>{% endif %}</li>{% endfor %}</ol>
  <div class="meta">{{ ep.note }}{% if ep.notebook %} · <a href="{{ ep.notebook }}">chat with these sources</a>{% endif %}</div>
</div>
{% endfor %}
{% endif %}

{% if queue %}
<h2>🎯 Deliberate practice</h2>
<div class="queue">
{% for q in queue %}
  <div class="q"><div class="lbl">{{ q.label }}</div>
    <a href="{{ q.url }}">{{ q.title }}</a>
    {% if q.note %}<div class="meta" style="margin-top:4px">{{ q.note }}</div>{% endif %}
  </div>
{% endfor %}
</div>
{% endif %}

{% for sec in sections %}
<h2>{{ sec.title }}</h2>
{% for it in sec["items"] %}
<div class="item">
  <div class="t"><a href="{{ it.url }}">{{ it.title }}</a></div>
  <div class="src">
    <span class="chip">{{ it.source }}</span>
    {%- if it.kind == 'event' %}{{ it.extra.start_local }}
    {%- elif it.published %}{{ it.ago }}{% endif %}
    {%- if it.duration_min %} · {{ it.duration_min }} min{% endif %}
    {%- if it.extra.authors %} · {{ it.extra.authors }}{% endif %}
    {%- if it.extra.discussion %} · <a href="{{ it.extra.discussion }}">discussion</a>{% endif %}
    {%- if it.extra.pdf %} · <a href="{{ it.extra.pdf }}">pdf</a>{% endif %}
    {%- if it.extra.podcast %} · 🎧 <a href="{{ it.extra.podcast }}">NotebookLM podcast</a>{% endif %}
  </div>
  {% if it.why %}<div class="why">{{ it.why }}</div>
  {% elif it.summary and it.kind != 'event' %}<div class="sum">{{ it.summary }}</div>{% endif %}
</div>
{% endfor %}
{% endfor %}

{% if opinions %}
<h2>🗣️ Take a stance — practice articulating it</h2>
<p class="meta">Pick one. Say your position out loud in 60 seconds, then steelman the other side.</p>
{% for o in opinions %}
<div class="op"><div class="qq">{{ o.q }}</div>
  <div class="meta" style="margin-top:4px">{{ o.context }}</div>
  <div class="side"><b>For</b> — {{ o['for'] }}</div>
  <div class="side"><b>Against</b> — {{ o.against }}</div>
</div>
{% endfor %}
{% endif %}

<footer>
  Not automated on purpose: 10-min X scroll of your follow list (Karpathy, Shreyas, Lenny, the Seattle AI folks).<br>
  <a href="archive.html">All briefs</a>{% if feed_url %} · <a href="{{ feed_url }}">Paper podcast feed</a>{% endif %} · generated {{ generated }}
</footer>
</div></body></html>
