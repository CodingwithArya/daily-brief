<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS: copy to ~/Library/LaunchAgents/, fix the two paths, then:
     launchctl load ~/Library/LaunchAgents/com.dailybrief.podcasts.plist
     Runs at 6:45am local; if the Mac is asleep it runs at next wake. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.dailybrief.podcasts</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Users/YOU/daily-brief/scripts/podcasts_local.sh</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
  <key>StandardOutPath</key><string>/Users/YOU/daily-brief/podcasts.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/daily-brief/podcasts.log</string>
</dict>
</plist>
